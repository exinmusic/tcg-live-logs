# Pokemon TCG Log Visualizer - Environment Variables
# Copy this file to .env and fill in the values

# Pokemon TCG API key for fetching card data from the API
VITE_POKEMONTCG_API_KEY=your_api_key_here

# AWS Cognito configuration for authentication
# Get these from your Cognito User Pool in the AWS Console (or CloudFormation stack outputs)
VITE_COGNITO_USER_POOL_ID=your_user_pool_id_here
VITE_COGNITO_CLIENT_ID=your_client_id_here

# API Gateway URL for backend (game log storage)
# Get this from the CloudFormation stack outputs (LogsApiUrl)
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# Base URL for card images (S3 Image Bucket URL after AWS deployment)
# In development, leave this unset to use local /card-images path
# After deploying to AWS, set this to your Image Bucket URL, e.g.:
#   VITE_IMAGE_BASE_URL=https://your-image-bucket.s3.amazonaws.com
VITE_IMAGE_BASE_URL=
